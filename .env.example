# rmail environment configuration. Copy to .env for local development.
# No secrets belong in this file — it documents knobs only.

# Unix domain socket that rmaild listens on and the `mail` CLI connects to.
# When unset, defaults to $HOME/.local/state/rmail/rmaild.sock. This bootstrap
# var is independent of the config system's grpc.socket_path and is ignored by
# the config env overlay.
RMAIL_SOCKET=

# SQLite database file rmaild opens at startup (running migrations). When unset,
# defaults to $HOME/.local/state/rmail/rmail.db (sibling to the socket).
RMAIL_DB=

# The TUI's key bindings (task 84). When unset, `keys.toml` beside the master
# config file — so pointing RMAIL_CONFIG at a second profile moves both. The
# file states only what differs from the built-in bindings, is re-read within
# a second of being saved (no restart), and is edited by
# `mail keys set <chord> <action>`.
RMAIL_KEYS=

# tracing-subscriber EnvFilter directive controlling rmaild log verbosity.
RUST_LOG=info

# rmaild log output format: "text" (default, human-readable) or "json"
# (structured single-line, for log shippers). Unset/unknown falls back to text.
RMAIL_LOG_FORMAT=text

# Bearer capability token presented by `mail mcp serve` on every RPC it makes
# on an agent's behalf (task 53). Mint one with
# `mail token create --name claude --scope mail.read`; the secret is printed
# exactly once.
#
# IMPORTANT: over the local Unix socket the daemon trusts the peer uid and
# grants the socket's owner admin *before* it reads this header, so a token set
# here narrows nothing server-side. What narrows the agent on that path is
# `mail mcp serve --scope`, which decides the tool list and which calls the
# server is willing to send. This variable is for the TCP listener, where there
# is no peer uid to trust. See rmail-cli/src/mcp_cli.rs' module docs.
#
# A bearer secret is opaque, so `mail mcp serve` cannot read what a token
# grants — pass the same scopes to `--scope`.
#
# `--scope mail.read` filters by scope, which is what the daemon enforces; it
# still lists `log_search_feedback`, the one capability that mutates at read
# scope (it improves your own later searches). `--read-only` is the stricter,
# effect-based statement: it withholds every tool that changes mail, spends at
# a model provider, or produces something that can — and refuses it rather than
# merely hiding it, so the shorter listing stays accurate. It does not mean "no
# writes at all": search is read-only by that measure and still appends to the
# local learning log, which `search.learning = false` turns off. There is no
# environment variable for it: the surface an agent is given is a
# per-invocation decision (task 54).
#
# This is a secret. Do not commit a real value.
#
# Since task 42 this is also `mail`'s own global `--token`: every verb presents
# it on every request. The caveat above still holds — over the Unix socket the
# peer-uid check wins and the token narrows nothing — so it matters on the
# `--addr` (TCP) path.
RMAIL_TOKEN=

# Default output shape for every `mail` verb: "table" (human columns, the
# default), "json" (one document per invocation) or "ndjson" (one JSON object
# per line, one per gRPC frame for a streaming verb). Same as the global
# `--format`, which overrides it (task 42).
#
# `json`/`ndjson` are a contract, not a display preference: key names come from
# the curated schema a verb documents, or from `proto/rmail/v1` for the verbs
# that emit their response message directly. A verb with no structured
# rendering *refuses* rather than printing a table — `mail api call <Method>
# '<json>'` prints any RPC's response as JSON. See rmail-cli/src/format.rs.
#
# Setting this globally makes every `mail` invocation in the shell structured,
# including the ones that then refuse; leaving it unset and passing --format
# per command is usually what you want.
RMAIL_FORMAT=

# The `rmaild` binary `mail daemon start` spawns. When unset: a sibling of the
# running `mail` binary (which is how a release tarball is laid out), then
# `rmaild` on PATH. Nothing else in the CLI ever starts a process — every other
# verb reports FAILED_PRECONDITION and names `mail daemon start` when the
# daemon is not running.
RMAILD_BIN=

# ── Configuration overlay ──────────────────────────────────────────────────
# Every field in the master TOML config can be overridden by an environment
# variable, without editing the file. The rule is uniform:
#
#   RMAIL_<TABLE>__<FIELD>[__<SUBFIELD>...]   (double underscore = nesting)
#
# Only variables whose first segment names a known top-level table are read
# (sync, search, index, ai, tags, notes, send, finder, grpc, hooks, webhooks,
# rules, notify, digest);
# anything else is ignored. Values use the same syntax as the TOML (durations like
# "5m", booleans, numbers, enum keywords such as "hybrid"/"none"/"pause").
#
# Representative examples (uncomment/adapt as needed):
#RMAIL_SYNC__INTERVAL=5m
# CONDSTORE/QRESYNC delta sync. Set false to force the UID-enumeration diff on
# servers whose modseqs cannot be trusted; correctness is unaffected, cost is.
# Honored by the sync engine; read by the daemon once SyncService lands.
#RMAIL_SYNC__QRESYNC=true
# Durable event-log retention. Both apply; whichever bites first wins. Rows
# bound disk; days bound how far back a disconnected client may resume before
# it is told OUT_OF_RANGE and has to resync.
#RMAIL_GRPC__EVENTS__RETENTION_DAYS=7
#RMAIL_GRPC__EVENTS__RETENTION_ROWS=1000000
# How long an `idempotency_key` on a mutating RPC (Move/Copy/SetFlags/Delete,
# ScheduleSend) stays claimed. Inside this window a retry replays the recorded
# response instead of applying the mutation twice; a key whose first attempt
# never reported an outcome is refused (ABORTED) for the same window rather
# than allowed to re-apply.
#RMAIL_GRPC__IDEMPOTENCY__RETENTION=1d
# How long a claim that never reported an outcome stays fenced — a client whose
# deadline elapsed mid-call, or whose connection dropped. Much shorter than the
# retention above, because that client's next act is to retry the same key.
# Both values are second-granular and floored at 1s.
#RMAIL_GRPC__IDEMPOTENCY__IN_FLIGHT=5m
#RMAIL_SEARCH__DEFAULT_MODE=hybrid
#RMAIL_SEARCH__RRF_K=60
# Per-retriever kill switches (task 28) — each candidate-generation source
# can be turned off independently without touching the others; a disabled
# source degrades a search's recall, never fails it.
#RMAIL_SEARCH__RETRIEVERS__DENSE=true
#RMAIL_SEARCH__RETRIEVERS__FUZZY=true
#RMAIL_SEARCH__RETRIEVERS__ENTITY=true
#RMAIL_SEARCH__RETRIEVERS__STRUCTURED=true
#RMAIL_SEARCH__RETRIEVERS__PREFIX=true
#RMAIL_SEARCH__RETRIEVERS__RECENCY=true
#RMAIL_SEARCH__RETRIEVERS__RECENCY_HALF_LIFE_DAYS=30

# OCR for image attachments and text-less (scanned) PDFs. Off by default —
# Apple Vision (macOS, no setup) or a `tesseract` binary on PATH (fallback,
# and the only option off macOS) both cost real CPU per attachment.
#RMAIL_INDEX__EXTRACT__OCR=true
# Tesseract-style codes; Vision maps the common ones itself. TOML array
# syntax, since this is one env var standing in for a list:
#RMAIL_INDEX__EXTRACT__OCR_LANGS=["eng"]

# Implicit-feedback personalization (task 64): the master switch for the local
# learning loop. `false` is a hard opt-out — search_log/search_impression/
# search_action are never written at all, not written and later ignored. What
# is collected is local telemetry that never leaves this machine; there is no
# RPC that reads it back out.
#RMAIL_SEARCH__LEARNING=true
# How much of that log is kept. Both bounds apply; whichever bites first wins.
# Worth setting deliberately: an impression carries a serialized 34-feature
# vector (~0.8 kB) and one search logs a whole page of them, which makes this
# the fastest-growing table in the database if left unbounded. Zero is a real
# answer on both — "keep nothing" — never a synonym for unlimited.
#RMAIL_SEARCH__FEEDBACK__RETENTION_DAYS=90
#RMAIL_SEARCH__FEEDBACK__MAX_QUERIES=10000

# Offline training and the model hot-swap (task 65). This is the subsystem
# that turns the log above into ranker weights, and the only one in rmail that
# can make search worse without anybody typing anything — so every knob below
# is a bound on how much the ranker may change, not a dial for how good it
# gets. Fully local: the log is read in process, the weights are fitted in
# process, and nothing about either leaves the machine.
#
# `enabled` gates only the *background* job. `mail search train`,
# `mail search models` and `mail search rollback` work regardless — turning
# this off means "not unattended", not "not available".
#RMAIL_SEARCH__TRAINING__ENABLED=true
#RMAIL_SEARCH__TRAINING__INTERVAL=24h
# Refuse to train below these. A model fitted to a handful of clicks is
# exactly the model that can beat the incumbent on a held-out slice by luck.
#RMAIL_SEARCH__TRAINING__MIN_QUERIES=50
#RMAIL_SEARCH__TRAINING__MIN_PAIRS=200
# The held-out slice, as a percentage of query *groups* (all repeats of one
# search text stay together, so a candidate is never judged on near-duplicates
# of its own training data). Must be 1-90.
#RMAIL_SEARCH__TRAINING__HOLDOUT_PERCENT=25
# ...and how many of those held-out queries must carry an engagement before
# the guardrail's verdict is trusted. NDCG over a slice nobody clicked in is
# 0.0 for every model, which is a tie rather than a measurement.
#RMAIL_SEARCH__TRAINING__MIN_EVAL_QUERIES=10
# Newest logged queries one run reads. Bounds memory: each carries a page of
# serialized feature vectors.
#RMAIL_SEARCH__TRAINING__MAX_TRAINING_QUERIES=2000
# Position-bias correction. `P(examined | rank p) = p^-eta`, and each
# preference pair is weighted by the inverse — so at the default a click at
# rank 8 counts eight times a click at rank 1, which is what stops the trainer
# from simply relearning the ranking that produced the clicks. 0 turns the
# correction off entirely.
#RMAIL_SEARCH__TRAINING__POSITION_BIAS_ETA=1.0
# Ceiling on one pair's inverse-propensity weight. Standard IPS clipping:
# without it a single click at rank 50 outvotes a whole small corpus. Must be
# at least 1.0.
#RMAIL_SEARCH__TRAINING__MAX_PROPENSITY_WEIGHT=10.0
# The guardrail. Held-out NDCG@10 the candidate must gain over the live model
# before it is allowed to go live; a candidate that does not clear it is
# recorded as rejected and nothing swaps.
#RMAIL_SEARCH__TRAINING__MIN_NDCG_GAIN=0.005
# The optimizer. `l2` pulls back toward the model that is already live, not
# toward zero, so "not enough signal" means "stay where you are".
#RMAIL_SEARCH__TRAINING__EPOCHS=60
#RMAIL_SEARCH__TRAINING__LEARNING_RATE=0.1
#RMAIL_SEARCH__TRAINING__L2=0.01
# Model rows retained. The live one is never pruned, so this is the depth of
# history a rollback can walk.
#RMAIL_SEARCH__TRAINING__MAX_MODELS=20

# Query/embedding/result caching (task 36). Every knob here is a *bound*, not
# an invalidation policy: a cached result page is keyed on the corpus version
# (a counter SQL triggers bump on every change to mail, flags, tags or
# extracted text) and on a digest of this whole `[search]` table, so new mail
# or a retuned ranker moves the key rather than leaving a stale answer
# readable. Nothing below can make a cache serve one.
#RMAIL_SEARCH__CACHE__ENABLED=true
# How long a cached result page may be served. Belt to the corpus version's
# braces: it bounds staleness for anything the triggers do not observe, and
# keeps a mailbox that never changes from serving one ranking for ever.
#RMAIL_SEARCH__CACHE__RESULT_TTL_SECS=300
# Hard ceilings; coldest evicted first. Zero on either is a real off switch
# for that cache, not a degenerate map that keeps one entry.
#RMAIL_SEARCH__CACHE__MAX_RESULTS=512
#RMAIL_SEARCH__CACHE__MAX_EMBEDDINGS=4096
# Seconds after a corpus change during which the result cache is not consulted
# at all, so freshly-synced mail is never hidden behind an answer computed a
# moment before it landed. Zero switches the bypass off — which is what you
# want when measuring hit rate, since with a nonzero window any search run
# right after a write is a bypass by definition.
#RMAIL_SEARCH__CACHE__FRESH_WINDOW_SECS=30

# L2 rerank (task 51): off | cross_encoder | claude | auto. `auto` uses the
# local cross-encoder for interactive search and Claude for an explicit deep
# search. Reranking is always best-effort — an unprovisioned model, a
# provider failure, or an exhausted AI budget degrades to the L1 ranking
# rather than failing the search.
#RMAIL_SEARCH__RERANK=auto
#RMAIL_SEARCH__TOP_K_RERANK=50
#RMAIL_SEARCH__RERANKER__CROSS_ENCODER_MODEL=bge-reranker-base
# Empty (the default) means the same cache the local embedder uses:
# $RMAIL_MODEL_CACHE, else $XDG_CACHE_HOME/rmail/models, else
# ~/.cache/rmail/models.
#RMAIL_SEARCH__RERANKER__CROSS_ENCODER_CACHE_DIR=
# Off by default, exactly like the embedder's own download switch: the
# cross-encoder's selling point is that mail text never leaves the host, so
# fetching several hundred megabytes of weights is an explicit act.
#RMAIL_SEARCH__RERANKER__CROSS_ENCODER_ALLOW_DOWNLOAD=false
#RMAIL_SEARCH__RERANKER__CLAUDE_MODEL=claude-haiku-4-5
#RMAIL_SEARCH__RERANKER__CLAUDE_MAX_CANDIDATES=30
#RMAIL_SEARCH__RERANKER__CLAUDE_MAX_TOKENS=4096
# In-memory (query, candidate-set) verdict cache. 0 disables it.
#RMAIL_SEARCH__RERANKER__CLAUDE_CACHE_ENTRIES=256
# Wall-clock ceiling for the whole rerank stage; overrunning it keeps the L1
# order.
#RMAIL_SEARCH__RERANKER__TIMEOUT=20s
#RMAIL_INDEX__SEMANTIC__PROVIDER=local
#RMAIL_INDEX__SEMANTIC__LOCAL__MODEL=bge-small-en-v1.5
#RMAIL_INDEX__SEMANTIC__LOCAL__DIM=384
# Off by default: the point of the local backend is that nothing leaves the
# host, so fetching the weights is an explicit act. Turn this on once to
# provision, or populate the cache directory out of band.
#RMAIL_INDEX__SEMANTIC__LOCAL__ALLOW_DOWNLOAD=false
#RMAIL_INDEX__SEMANTIC__LOCAL__CACHE_DIR=
#RMAIL_INDEX__SEMANTIC__VOYAGE__API_KEY_COMMAND=security find-generic-password -s voyage -w
#RMAIL_AI__ENABLED=true
#RMAIL_AI__PROVIDER=claude
#RMAIL_AI__LIMITS__DAILY_COST_CAP_USD=5.00
#RMAIL_AI__LIMITS__ON_CAP=pause
# Per-call budget enforcement (ai::budget). The caps above are the *global*
# ceilings this enforces at a finer grain — per account, per work class, and
# with a soft cap that downgrades the model (opus -> sonnet -> haiku) before
# the hard cap blocks. Explicit per-account budgets are stored via
# `mail ai budget set` / AiPolicyService.SetBudget, not configured here.
#RMAIL_AI__LIMITS__BUDGET__ENABLED=true
# Where the soft cap sits as a fraction of the hard cap, for any cap a stored
# budget leaves unset. Outside 0..1 disables the derived soft cap.
#RMAIL_AI__LIMITS__BUDGET__SOFT_CAP_RATIO=0.8
# The share of a scope's caps bulk (backlog) work may consume, so a backfill
# cannot spend the whole day's budget out from under interactive work.
#RMAIL_AI__LIMITS__BUDGET__BULK_SHARE=0.5
# Queue priority at or beyond which a job is charged as bulk work
# (ai::queue::PRIORITY_BACKFILL).
#RMAIL_AI__LIMITS__BUDGET__BULK_PRIORITY=500
# The downgrade ladder. Every id here must be one `ai::estimate_cost_usd`
# prices, or a downgraded call records a cost of 0 and the hard cap stops
# counting exactly when it matters most.
#RMAIL_AI__LIMITS__BUDGET__LADDER__OPUS=claude-opus-4-8
#RMAIL_AI__LIMITS__BUDGET__LADDER__SONNET=claude-sonnet-5
#RMAIL_AI__LIMITS__BUDGET__LADDER__HAIKU=claude-haiku-4-5
# Data-residency/AI-eligibility policy defaults (ai::policy::PolicyEngine).
# Applies only when no account/folder/pattern rule in ai.policy.rules matches
# — rules themselves (an array) are not practically env-settable and belong
# in the TOML file. See the `ai::policy` module docs for why "allowed" is the
# safe default despite being the permissive-sounding one.
#RMAIL_AI__POLICY__DEFAULT_MODE=allowed
#RMAIL_AI__POLICY__DEFAULT_RESIDENCY=unspecified
# The fully on-device inference path (task 78, ai::local). Setting
# RMAIL_AI__PROVIDER=local is structural, not a preference: the daemon then
# builds no HTTP client for AI at all, so nothing in the process can dial out
# for a model. `mail ai provider set <account> local` does the same for one
# account without a restart, and an `ai.policy` rule of `local_only` forces
# it per folder whatever either of those says.
#
# The runtime is a command you already have — llama.cpp, mlx, ollama, a
# wrapper script — because linking an inference engine into this binary would
# put a multi-gigabyte build into every deployment, including the ones that
# will never run a local model. The prompt is written to its stdin and the
# completion read from its stdout; %model% expands to the resolved weights
# path and %max_tokens% to the request's output cap.
#RMAIL_AI__LOCAL__MODEL=qwen2.5-3b-instruct-q4_k_m
# Absolute, or relative to the shared model cache (RMAIL_MODEL_CACHE, the same
# directory the local embedder and reranker provision into).
#RMAIL_AI__LOCAL__MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
# A JSON array; empty (the default) means the local path is not configured.
#RMAIL_AI__LOCAL__RUNTIME_COMMAND=["llama-cli","-m","%model%","-n","%max_tokens%","--no-display-prompt","-f","/dev/stdin"]
# A local model on a small machine is slow, not broken — but a wedged runtime
# must not hold an AI worker permit forever.
#RMAIL_AI__LOCAL__TIMEOUT_SECS=300
#RMAIL_AI__LOCAL__MAX_OUTPUT_BYTES=1048576
# An over-long prompt is refused, never truncated: truncation drops the end of
# the transcript, which is where the instruction is.
#RMAIL_AI__LOCAL__MAX_PROMPT_BYTES=262144
# Anything smaller than this is treated as an interrupted download rather than
# a model, so an operator is told to re-fetch rather than to fetch.
#RMAIL_AI__LOCAL__MIN_MODEL_BYTES=1048576
# Prompt-injection shield (task 77, ai::injection). Neither knob turns off the
# part that actually protects anything: untrusted mail is wrapped in labelled
# delimiters and declared data-not-instruction on every path that shows it to
# a model, unconditionally.
# Whether the pattern detector runs and records what it finds. Turning it off
# necessarily disables the action gate below too — a gate with nothing to gate
# on cannot fail closed — so this is an explicit opt-out, not a speed knob.
#RMAIL_AI__INJECTION__ENABLED=true
# The lowest severity that withholds an AI-decided rule action pending
# confirmation: hostile | suspicious | never.
# "hostile" covers text addressed to the model (an instruction override, forged
# system/tool framing, an exfiltration request). "suspicious" additionally
# covers obfuscation on its own (zero-width characters, homoglyphs, CSS-hidden
# text), which real marketing mail carries often enough that it is not the
# default: a gate that fires on half a mailbox is a gate an operator turns off.
# An unrecognized value here fails OPEN and warns at startup — see
# `AiInjection::block_at` for why this is the one operator string in the AI
# config that deliberately does not fail closed.
#RMAIL_AI__INJECTION__BLOCK_ACTIONS_AT=hostile

# Mailbox RAG (AiService.AskMailbox / `mail ask`). Deliberately a small table:
# whether a call may happen at all is already governed by ai.limits, ai.privacy
# and ai.policy, and `ask` draws on those rather than restating them.
#
# It governs AttachmentService.AskAttachment (`mail attach ask`, task 74) too,
# rather than that surface getting a near-identical table of its own. The two
# are the same operation over different corpora — same model tier, same one
# ai.limits budget, same context ceiling — and a second [ai.attach_ask] would
# have been four knobs whose only honest documentation was "like ai.ask".
# Read TOP_K as "how many attachments", and MAX_CHARS_PER_MESSAGE as "how much
# of one attachment", which is also what sets how many passages of it are
# packed: raise it to have a long contract quoted from more than one place.
# The model that writes the grounded answer — sonnet, not ai.models.deep's
# opus tier: this is prd.md's "balanced default for RAG/drafting".
#RMAIL_AI__ASK__MODEL=claude-sonnet-5
# How many messages retrieval returns before the token budget cuts further.
#RMAIL_AI__ASK__TOP_K=12
# Ceiling on the assembled context, in estimated tokens. Packing stops at the
# first message that would cross it rather than skipping to a shorter, less
# relevant one.
#RMAIL_AI__ASK__MAX_CONTEXT_TOKENS=8000
# How much of one message's body may enter the context, bounded per message as
# well as in aggregate so one enormous message cannot crowd out every other
# citation. Also clamped by ai.privacy.max_body_chars, which always wins.
#RMAIL_AI__ASK__MAX_CHARS_PER_MESSAGE=2000
# Output-token ceiling for the answer.
#RMAIL_AI__ASK__MAX_TOKENS=1024
#RMAIL_TAGS__DEFAULT_SYNC_MODE=auto
#RMAIL_TAGS__HIERARCHY_SEPARATOR=/
# Prefix applied to a tag's name before it round-trips as a plain IMAP
# keyword (task 55) — load-bearing: this is exactly what lands on the
# user's mail server, not just a local default.
#RMAIL_TAGS__IMAP__KEYWORD_PREFIX=rmail/
#RMAIL_TAGS__IMAP__MAP_SYSTEM=true
#RMAIL_TAGS__IMAP__GMAIL_LABELS=true
# Scheduled send and the durable outbox (task 61). Every outgoing message is
# scheduled — an "immediate" send is really `now + undo_window`, which is what
# makes undo a cancel rather than a recall.
#RMAIL_SEND__UNDO_WINDOW=10s
# The zone bare wall-clock expressions ("tomorrow 9am") are read in, and the
# one a scheduled message records for display. The instant itself is frozen at
# schedule time, so changing this never moves an already-scheduled message.
#RMAIL_SEND__DEFAULT_TIMEZONE=America/Los_Angeles
# Upper bound on how long the scheduler sleeps with nothing due. It also bounds
# how late a message can go out after the machine wakes from suspend, since a
# monotonic timer does not advance while the lid is closed.
#RMAIL_SEND__POLL_INTERVAL=30s
# How overdue a send may be before it is flagged "sent late (was offline)". It
# is never a reason not to send — nothing is ever dropped for being overdue.
#RMAIL_SEND__LATE_TOLERANCE=10m
#RMAIL_SEND__MAX_RETRIES=5
#RMAIL_SEND__BACKOFF_BASE=30s
#RMAIL_SEND__BACKOFF_MAX=30m
#RMAIL_SEND__APPEND_TO_SENT=true
# MCP-originated sends always get an undo window so a human can intercept.
# Setting this false shortens that window to a hard 10s floor; it cannot
# remove it (see `rmail_core::outbox::policy`).
#RMAIL_SEND__AI_REQUIRES_CONFIRMATION=true
# Bounded SMTP worker pool: how many messages may be in flight at once.
#RMAIL_SEND__WORKERS=2
# How SMTP submission is secured: auto | starttls | implicit_tls | plaintext.
# `auto` picks implicit TLS on port 465 and STARTTLS everywhere else, and never
# resolves to plaintext — a silent downgrade is how credentials reach the wire.
# `plaintext` is for a trusted local relay only.
#RMAIL_SEND__SMTP_SECURITY=auto
#RMAIL_SEND__OPTIMAL__ENABLED=true
#RMAIL_SEND__OPTIMAL__EARLIEST=08:00
#RMAIL_SEND__OPTIMAL__LATEST=18:00
#RMAIL_SEND__FOLLOWUP__DEFAULT_DELAY=3d
#RMAIL_SEND__FOLLOWUP__CANCEL_ON_REPLY=true
# The waiting-on tracker (task 63). Judging a sent message is explicit —
# `SendSchedulerService.TrackFollowup` — so there is no on/off switch here:
# nothing is spent until something asks. A judged deadline is clamped into
# [4h, max_delay], so a judge that answers "300 days" cannot arm a reminder
# nobody will ever see.
#RMAIL_SEND__FOLLOWUP__MODEL=claude-haiku-4-5
#RMAIL_SEND__FOLLOWUP__MAX_DELAY=30d
# The pre-send guardian (task 63): "see attached" with nothing attached,
# unfilled placeholders, apparent secrets, wrong/extra recipients, tone.
# `enabled` gates the automatic check on send; PreflightCheck answers either
# way, since that one is an explicitly requested review.
#RMAIL_SEND__PREFLIGHT__ENABLED=true
# The model layer on top of the deterministic checks. Turning it off costs the
# tone pass and nothing else: a model finding can never block a send, so what
# this daemon refuses is identical with it on or off.
#RMAIL_SEND__PREFLIGHT__AI=true
#RMAIL_SEND__PREFLIGHT__MODEL=claude-haiku-4-5
# How long the model review may take before the guardian gives up on it and
# reports itself degraded. This is the bound that keeps a wedged provider from
# holding a send open; the deterministic findings still apply.
#RMAIL_SEND__PREFLIGHT__TIMEOUT=15s
# The lowest severity that *refuses* a send: block | warn | notice | never.
# Anything unrecognized is treated as `never` and warned about at startup —
# mail must not stop because of a typo in a config file.
#RMAIL_SEND__PREFLIGHT__BLOCK_AT=block
#RMAIL_SEND__PREFLIGHT__MAX_RECIPIENTS=15
# AI reply drafting (task 62) — `mail reply <id> --ai "…"`,
# `ComposeService.DraftReply`, and the tone/length rewrite. There is no on/off
# switch: drafting is always explicitly invoked, so nothing is spent until
# somebody asks, and `ai.enabled = false` already makes the RPCs refuse.
# A drafted reply is staged as an editable draft and is never sent; it leaves
# the machine only through `mail send`, past the pre-send guardian above.
# prd.md's "claude-sonnet-5 default for RAG/drafting" — not `ai.models.deep`,
# which is the opus tier a per-message deep pass uses.
#RMAIL_SEND__REPLY__MODEL=claude-sonnet-5
#RMAIL_SEND__REPLY__MAX_TOKENS=2048
# Bounds a *rewrite* — the whole call, including the wait for AI concurrency,
# not only the network hop. DraftReply has no equivalent because it streams:
# its client holds the deadline, and a server-side timer that cut a stream
# mid-sentence would destroy a draft the user could already read.
#RMAIL_SEND__REPLY__TIMEOUT=60s
# How many of the thread's most recent messages reach the prompt, and how many
# of your own past replies to the same correspondent are sampled for voice
# (0 disables voice sampling), with a per-sample character bound.
#RMAIL_SEND__REPLY__THREAD_MESSAGES=12
#RMAIL_SEND__REPLY__VOICE_SAMPLES=3
#RMAIL_SEND__REPLY__SAMPLE_CHARS=1500
# Whether a drafted reply quotes the message it answers below the new text,
# the way a hand-written reply does, and how much of it is kept.
#RMAIL_SEND__REPLY__QUOTE_ORIGINAL=true
#RMAIL_SEND__REPLY__QUOTE_CHARS=4000
# Fuzzy finder (task 59) — `mail find`, and the TUI's Ctrl-P overlay. Local
# only; it never contacts IMAP. Disabling it stops the index being maintained;
# FinderService still answers, over an empty index that `mail find --status`
# reports honestly.
#RMAIL_FINDER__ENABLED=true
# Which kinds a query with no sigil searches: all | messages | contacts |
# folders | tags | saved_searches | commands. A leading >/#/@/'/'/: in the
# query overrides it per keystroke.
#RMAIL_FINDER__DEFAULT_SCOPE=all
#RMAIL_FINDER__MAX_RESULTS=200
#RMAIL_FINDER__SNIPPET_MAX_BYTES=160
# The two hard bounds on the in-memory index — see rmail_core::finder::store.
# The whole index is resident so a keystroke never touches disk, which only
# works if "resident" has a size. Whichever binds first wins, and both drop
# the *oldest* mail: `mail find --status` reports how much was turned away.
# 25 MiB holds roughly 100k messages.
#RMAIL_FINDER__MAX_ENTRIES=200000
#RMAIL_FINDER__MAX_MEMORY_MB=25
# How often the change feed is drained into the in-memory index, and the most
# feed rows one pass applies. The cap is what keeps a full mailbox resync
# costing the finder a few seconds of staleness rather than a stall.
#RMAIL_FINDER__REFRESH_INTERVAL_MS=250
#RMAIL_FINDER__MAX_DRAIN_BATCH=2000
# Any uppercase character in the query makes matching case-sensitive.
#RMAIL_FINDER__SMART_CASE=true
#RMAIL_FINDER__PREVIEW=true
# Blended-ranking weights. `w_recency` multiplies exp(-age/half_life) scaled
# 0..64; the rest multiply 0..1 terms. Zero them all to rank by the raw
# subsequence score alone.
#RMAIL_FINDER__RANKING__HALF_LIFE_DAYS=30
#RMAIL_FINDER__RANKING__W_RECENCY=40.0
#RMAIL_FINDER__RANKING__W_UNREAD=25.0
#RMAIL_FINDER__RANKING__W_IMPORTANT=30.0
#RMAIL_FINDER__RANKING__W_FREQUENCY=10.0
#RMAIL_FINDER__RANKING__W_KIND=15.0
#RMAIL_GRPC__AUTH=token
#RMAIL_GRPC__SOCKET_PATH=~/.local/state/rmail/rmaild.sock
# Event-hook dispatcher (task 67): config-driven shell commands on mail
# events. Individual hooks (`[[hooks.hooks]]`) are an array of tables and are
# not practically env-settable — add/inspect/test them with
# `mail hook add/list/test`, or edit the TOML file directly.
#RMAIL_HOOKS__ENABLED=true
#RMAIL_HOOKS__MAX_CONCURRENCY=4
#RMAIL_HOOKS__DEFAULT_TIMEOUT=30s
#RMAIL_HOOKS__TICK_INTERVAL=5s
#RMAIL_HOOKS__MAX_OUTPUT_BYTES=65536
# Outbound webhooks (task 68): the network sibling of the hook dispatcher, and
# the only thing in rmail that puts your mail on somebody else's server.
#
# OFF BY DEFAULT, unlike hooks — a hook's blast radius is this machine, a
# webhook's is the internet. Two switches have to be thrown before anything is
# sent: this one, and a *destination* existing at all. Destinations are not
# configured here; they are live rows with their own delivery queue and are
# added/inspected/removed with
# `mail webhook add/list/rm/enable/disable/deliveries/replay` (WebhookService).
# Only the dispatcher's dials are env-settable.
#
# The default payload is sender + subject + a deep link + (when the AI passes
# have already run) a two-sentence summary — never the body, unless that one
# destination was registered with `--include-body`. Everything derived from
# message content goes through the `[ai.privacy]` redaction firewall first.
# Signing keys are referenced, never inlined: `--secret-env`/`--secret-command`/
# `--secret-keychain`, resolved the same way an account password is. A keychain
# item is addressed by (service = --secret-keychain, account = the
# destination's --name).
#RMAIL_WEBHOOKS__ENABLED=false
#RMAIL_WEBHOOKS__MAX_CONCURRENCY=4
#RMAIL_WEBHOOKS__TICK_INTERVAL=5s
# Per-attempt HTTP timeout; also the lease a claimed delivery holds, so a
# process that dies mid-attempt frees the row instead of wedging it.
#RMAIL_WEBHOOKS__DELIVERY_TIMEOUT=15s
# First retry delay, doubling per attempt up to the ceiling. A delivery whose
# per-destination attempt cap is spent moves to `failed` and stops; `mail
# webhook replay <id>` is the only way back out.
#RMAIL_WEBHOOKS__BACKOFF_BASE=30s
#RMAIL_WEBHOOKS__BACKOFF_MAX=30m
#RMAIL_WEBHOOKS__MAX_BATCH=100
# Rules engine (task 66): TOML rules pairing deterministic predicates with a
# `claude_is` natural-language predicate. The rules themselves are per account
# and live in the database, not here — create/list/backtest them with
# `RuleService` (`mail rule ...`). Only the knobs governing how they run are
# env-settable.
# `enabled` gates only the automatic on-new-mail evaluator; RuleService keeps
# serving create/list/evaluate/backtest either way.
#RMAIL_RULES__ENABLED=true
#RMAIL_RULES__TICK_INTERVAL=5s
#RMAIL_RULES__MAX_BATCH=200
# Where an `archive = true` action moves mail.
#RMAIL_RULES__ARCHIVE_MAILBOX=Archive
# Bounds on the *untrusted* regexes a rule carries — they come from a user (or
# from a model, via SynthesizeRule) and then run unattended against every new
# message. max_pattern_len caps the source text; regex_size_limit_bytes caps
# the compiled program, which is what refuses a counted-repetition bomb at rule
# creation instead of at match time; max_match_chars caps how much of a field a
# pattern is run over.
#RMAIL_RULES__MAX_PATTERN_LEN=512
#RMAIL_RULES__REGEX_SIZE_LIMIT_BYTES=262144
#RMAIL_RULES__MAX_MATCH_CHARS=65536
# How many user corrections are replayed as few-shot examples on an uncached
# `claude_is` call. Every example is tokens on every such call.
#RMAIL_RULES__MAX_EXAMPLES=8
# How many messages a backtest or synthesis dry run examines, and the default
# window in days when a request does not name one.
#RMAIL_RULES__MAX_WINDOW_MESSAGES=500
#RMAIL_RULES__DRY_RUN_DAYS=30

# ── Autonomous inbox agent (task 69) ───────────────────────────────────────
# A bounded loop that walks a mailbox, asks Claude what to do with each message
# against a policy you wrote, and performs the answer — from a closed set of
# five reversible actions (archive / label / snooze / draft-reply / escalate).
# Nothing it can do sends mail or deletes anything, and a message flagged for
# prompt injection produces no action at all.
#
# THIS IS THE ONE FEATURE THAT ACTS ON YOUR MAIL WITH NO HUMAN IN THE LOOP.
# `allow_mutations` is the machine owner's switch and is OFF by default: with
# it off, no token and no request can make this daemon's agent touch anything,
# and `RunInboxAgent --mutate` is refused with FAILED_PRECONDITION. A dry run
# still works, so you can watch what it *would* do before arming it.
#RMAIL_AGENT__ALLOW_MUTATIONS=false
# The model that decides. Haiku: a per-message triage decision over text
# already in front of it, run in a loop. A more capable model is not a safety
# improvement here — what bounds the damage is the closed vocabulary and the
# injection shield, not the model's judgement.
#RMAIL_AGENT__MODEL=claude-haiku-4-5
# The mailbox a run walks when the request names none, and where `archive`
# moves mail to. The destination is configuration and never the model's
# choice: a mailbox the model could name would be a MOVE to anywhere in the
# account.
#RMAIL_AGENT__MAILBOX=INBOX
#RMAIL_AGENT__ARCHIVE_MAILBOX=Archive
# The labels a `label` action may apply, exactly. EMPTY by default, which makes
# `label` unavailable: the action is not offered to the model and any answer
# naming it is refused. An unconstrained label action would be a model-authored
# write into your tag namespace, since an unknown tag name is simply created.
#RMAIL_AGENT__LABELS=[]
# The tag a `snooze` applies. A snooze defers the *agent* — it stops
# reconsidering the message until the time passes — and tags it so the state is
# visible where you already look (`mail tags`, `tag:` in search, smart
# folders). It does NOT remove the message from your inbox listing, and no
# server-side mutation is involved. Operator configuration for the same reason
# `labels` is: an unknown tag name is simply created.
#RMAIL_AGENT__SNOOZE_TAG=snoozed
# The longest `snooze`, in hours. A request outside 1..=max is refused rather
# than clamped, so the log says what was actually asked for.
#RMAIL_AGENT__MAX_SNOOZE_HOURS=168
# The three bounds on one run, all clamped by hard ceilings in the code:
# messages considered (each is a model call), mutations performed (the bound on
# blast radius — the most mail one run can touch), and wall clock.
# max_actions = 0 means "consider everything, change nothing".
#RMAIL_AGENT__MAX_ITERATIONS=25
#RMAIL_AGENT__MAX_ACTIONS=10
#RMAIL_AGENT__MAX_DURATION=300s
# How many runs `GetAgentRunLog` (`mail agent log`) returns by default.
#RMAIL_AGENT__LOG_LIMIT=20

# ── Priority notifications (task 81) ───────────────────────────
# Score every newly synced message with Haiku into an importance tier plus a
# one-line reason, and fire a local desktop notification only at or above the
# threshold. OFF by default: it costs one model call per message on top of
# triage's, so it is something you turn on, not something you discover on an
# invoice.
#RMAIL_NOTIFY__ENABLED=false
# Minimum tier that pings: low | normal | high | critical. Overridable per
# account (`[[accounts]] notify.threshold`), which is an array of tables and so
# is not env-settable. An unrecognized value delivers NOTHING (fails closed);
# to turn notifications off, use `enabled = false` rather than a made-up tier.
#RMAIL_NOTIFY__THRESHOLD=high
# How recently a message must have ARRIVED to be scored at all. This is what
# makes switching the feature on safe: the AI dispatch loop replays the whole
# event-log retention window (7 days) on every restart, so without a bound the
# first boot after enabling would pay to score a week of already-read mail and
# then interrupt you about all of it. Anything older is declined before the
# model call.
#RMAIL_NOTIFY__MAX_MESSAGE_AGE=60m
# Where a fired notification goes: "auto" (macOS Notification Center via
# osascript, nothing on other platforms) or "none". There is deliberately no
# webhook/push channel — nothing here leaves the machine.
#RMAIL_NOTIFY__CHANNEL=auto
# What the desktop notification may say. The sender and tier are always shown;
# the message body never is, under any setting.
#RMAIL_NOTIFY__INCLUDE_SUBJECT=true
#RMAIL_NOTIFY__INCLUDE_REASON=false
# Daily do-not-disturb window. A notification that arrives inside it is HELD
# until the window closes, never dropped. `timezone` is an IANA name; empty
# means the host's local zone.
#RMAIL_NOTIFY__QUIET_HOURS__ENABLED=false
#RMAIL_NOTIFY__QUIET_HOURS__START=22:00
#RMAIL_NOTIFY__QUIET_HOURS__END=07:00
#RMAIL_NOTIFY__QUIET_HOURS__TIMEZONE=
# Delivery loop pacing and bounds.
#RMAIL_NOTIFY__TICK_INTERVAL=5s
#RMAIL_NOTIFY__MAX_ATTEMPTS=3
#RMAIL_NOTIFY__RETRY_BACKOFF=30s
#RMAIL_NOTIFY__DELIVERY_TIMEOUT=10s
#RMAIL_NOTIFY__MAX_PER_TICK=20

# ── Periodic AI digest (task 70) ───────────────────────────────
# On a timer, cluster one window of mail by thread/topic/sender and have Claude
# write a ranked markdown briefing — needs-reply, FYI, waiting-on, auto-handled,
# skipped — in which every line cites the message-ids it came from.
#
# OFF by default, like notifications and for the same reason: this is a Sonnet
# call on a schedule. `mail digest` and `AnalyticsService.GenerateDigest` keep
# working with this off — what the switch gates is unattended, recurring spend,
# not your own explicit request.
#RMAIL_DIGEST__ENABLED=false
# The model that writes the briefing. A briefing is a synthesis task over many
# messages, so this is the Sonnet tier rather than triage's Haiku.
#RMAIL_DIGEST__MODEL=claude-sonnet-5
# The cadence. Periods are absolute, anchored at the unix epoch, which is what
# makes a period a stable identity across restarts — so `24h` is a UTC day and
# `168h` is a week that begins on a Thursday. One window gets exactly one
# briefing, forever, unless you ask for another with `mail digest --force`.
#RMAIL_DIGEST__INTERVAL=24h
# How often the scheduler checks whether a period has finished. An upper bound
# on how LATE a briefing is, never on what it covers.
#RMAIL_DIGEST__TICK_INTERVAL=15m
# How many missed periods one tick will catch up on. A daemon that was off for
# a month briefs the most recent 7 days and skips the rest, rather than making
# thirty model calls in one tick.
#RMAIL_DIGEST__MAX_CATCHUP_PERIODS=7
# The size of one briefing: how many of the window's messages may enter it
# (after clustering has ranked them), how many clusters it covers, and the
# token/character bounds on the assembled context. `max_chars_per_message` is
# additionally clamped by `ai.privacy.max_body_chars`.
#RMAIL_DIGEST__MAX_MESSAGES=120
#RMAIL_DIGEST__MAX_CLUSTERS=15
#RMAIL_DIGEST__MAX_CONTEXT_TOKENS=12000
#RMAIL_DIGEST__MAX_CHARS_PER_MESSAGE=800
#RMAIL_DIGEST__MAX_TOKENS=2048

# ── Structured extraction (task 75) ────────────────────────────
# Tables out of attachments, calendar events and tasks out of a message and its
# .ics, and a ranked link picker. Most of this needs no model at all: a
# workbook, a CSV, an HTML table, an .ics and every `<a href>` are parsed. A
# model is only reached for a PDF's or an image's tables, for events stated in
# prose, and to refine a link ranking that already exists without it.
#
# The model tier is Haiku: all three are structured classification over text
# already in front of the model, and this runs per message a user asks about.
#RMAIL_EXTRACT__MODEL=claude-haiku-4-5
#RMAIL_EXTRACT__MAX_TOKENS=4096
# OCR languages for the image-table route, matching index.extract.ocr_langs.
#RMAIL_EXTRACT__OCR_LANGS=en-US
#
# The two sinks extracted events and tasks can be pushed to. Both are EMPTY by
# default and asking for one that is unconfigured is an error, not a silent
# no-op: a sink is the part of this that leaves the machine, and a user must
# not believe their task tracker was updated when it was not.
#
# `command` gets the .ics on its stdin and nothing from the message on its
# argv — a sink whose arguments a sender could influence would be code
# execution by email. On macOS this is typically an `osascript` that adds to
# Reminders or Calendar.
#RMAIL_EXTRACT__COMMAND=
#RMAIL_EXTRACT__COMMAND_ARGS=
# `webhook` receives a JSON POST carrying the message id, the item UIDs and the
# rendered .ics. Delivery is idempotent per (message, item, sink), so a retried
# RPC does not create the task twice.
#RMAIL_EXTRACT__WEBHOOK_URL=

# ── Local embedding model ──────────────────────────────────────────────────
# Where the ONNX weights for `index.semantic.provider = "local"` are cached.
# Defaults to $XDG_CACHE_HOME/rmail/models, else ~/.cache/rmail/models. They are
# fetched from Hugging Face on first use; on a host with no egress, populate the
# directory out of band and point this at it.
#RMAIL_MODEL_CACHE=

# ── Secrets ────────────────────────────────────────────────────────────────
# Account credentials are NEVER inlined in config. Each account references a
# secret indirectly via one of: password_command (a shell command whose stdout
# is the password), password_env (the NAME of an env var holding it), or
# keychain (a macOS Keychain service name). If you use password_env, define the
# named variable in your real environment — do not commit it here. Example:
#MY_FASTMAIL_PASSWORD=

# ── OAuth2 (Gmail / Outlook) ───────────────────────────────────────────────
# Gmail and Outlook do not accept passwords over IMAP/SMTP; they want an OAuth2
# bearer token (XOAUTH2). Register a *desktop/native* application with the
# provider and authorize an account with:
#
#   mail account login <id> --oauth google --client-id <id>.apps.googleusercontent.com
#   mail account login <id> --oauth outlook --client-id <application-id>
#
# The client id is not a secret and is passed on the command line. Google's
# "Desktop app" client type also issues a client secret; pass a *command* that
# prints it rather than the value itself:
#
#   --client-secret-command 'security find-generic-password -s rmail-google -w'
#
# The refresh token that comes back is written to the macOS Keychain by the
# daemon and never touches this file, the config, or the database. There is no
# environment variable for it, by design.

# ── OpenPGP auto-encryption ────────────────────────────────────────────────
# rmail encrypts outbound mail whenever every recipient has a discoverable
# public key. This is on by default: opportunistic encryption is only worth
# anything if it does not require anyone to remember to switch it on, and the
# failure mode of the default is a message that goes out in the clear exactly
# as it would have anyway.
#
# Turn the whole feature off:
#RMAIL_CRYPTO__AUTO_ENCRYPT=false
#
# Default policy for a recipient with no explicit override:
#   auto   - encrypt when a key is known, send in the clear otherwise
#   always - refuse to send unless every recipient has a key
#   never  - never encrypt
# `always` is not a stricter `auto`: it trades "the mail always goes" for
# "the mail is never readable in transit", and it will fail sends.
#RMAIL_CRYPTO__POLICY=auto
#
# How long a discovered key is trusted before it is looked up again. Capped by
# the key's own expiry, so this is an upper bound — a key that expires next
# week stops being used next week regardless of what this says.
#RMAIL_CRYPTO__KEY_TTL=30d
#
# How long "this address has no key" suppresses further lookups. Most
# addresses have no OpenPGP key and never will; without this, every draft to
# every one of them re-queries the network and re-broadcasts who you are
# emailing. Lower it to notice newly-published keys sooner.
#RMAIL_CRYPTO__NEGATIVE_TTL=30d
#
# Whole-chain budget for one address's discovery, across every source.
#RMAIL_CRYPTO__DISCOVERY_TIMEOUT=20s
#
# Discovery sources. Both are on by default and neither discloses anything:
# `autocrypt` reads keys out of mail already in your mailbox (no request at
# all), and `wkd` asks the recipient's own domain, which is about to receive
# the message regardless.
#RMAIL_CRYPTO__AUTOCRYPT=true
#RMAIL_CRYPTO__WKD=true
#
# Warn instead of silently switching when a known correspondent presents a new
# key fingerprint. Leave this on. It is the only thing standing between you
# and an attacker who can publish a key for someone you already trust — and
# note that when it fires, rmail sends in the *clear* rather than encrypting
# to the new key, because handing the plaintext to whoever published it would
# be worse than not encrypting.
#RMAIL_CRYPTO__WARN_ON_KEY_CHANGE=true
#
# Ceiling on a fetched key, in bytes. Keyservers serve attacker-influenced
# bytes — anyone can upload a key claiming any address — so this bounds what a
# single crafted upload can make the background task allocate.
#RMAIL_CRYPTO__MAX_KEY_BYTES=262144
#
# Keyservers. There is deliberately no default: a mail client should not ship
# a configuration that sends your contact graph to a third party before you
# have read this paragraph. Every keyserver query carries the address being
# looked up, so a public server learns who you are about to email.
#
# Servers are configured in the TOML config file rather than here, because
# each is a table:
#
#   [[crypto.keyservers]]
#   name = "corp"
#   url  = "https://keys.internal.example"
#   kind = "private"          # tried before any public server
#   token_env = "CORP_KEYSERVER_TOKEN"   # names an env var, never the secret
#
#   [[crypto.keyservers]]
#   name = "openpgp"
#   url  = "https://keys.openpgp.org"
#   kind = "public"           # only reached when every private source misses
#
# Discovery always runs autocrypt -> wkd -> private servers -> public servers
# and stops at the first usable key, so enabling a public server does not mean
# every recipient's address is sent to it — only the ones nothing closer to
# home could answer for.
#
# The bearer token for a private server goes in the named variable:
#CORP_KEYSERVER_TOKEN=

# ── Client auth ─────────────────────────────────────────────────────────────
# Password access to rmail's own API (ClientAuthService) — distinct from
# account credentials (IMAP/SMTP) and from the mail-encryption settings
# above. Not configured by default: a Unix-socket peer is trusted implicitly
# (the daemon's own uid), which is the same behavior rmail has always had.
# `mail auth setup` turns this on by setting a password; nothing here forces
# that.
#
# Whether a Unix-socket peer's kernel-verified uid is enough by itself, or
# every caller — local included — must present a bearer token (minted
# directly, or obtained via `mail auth login`). Off by default: it changes
# nothing until a password exists, and the daemon refuses to start with this
# on and no password configured (see `rmaild::ServeError::LocalLoginRequiredWithNoCredential`)
# rather than locking its own operator out.
#RMAIL_CLIENT_AUTH__REQUIRE_FOR_LOCAL=false
#
# How long a token `mail auth login` mints lasts before it must be obtained
# again.
#RMAIL_CLIENT_AUTH__SESSION_TTL=30d
#
# Consecutive failed login attempts before lockout closes the gate —
# Argon2id makes each guess expensive, but only lockout stops an attacker
# with a large request budget from just paying that cost repeatedly.
#RMAIL_CLIENT_AUTH__MAX_ATTEMPTS=5
#
# How long a lockout lasts once MAX_ATTEMPTS is reached.
#RMAIL_CLIENT_AUTH__LOCKOUT=15m
