/target
**/*.rs.bk
.env
*.sock

# scripts/package-macos.sh output — build artifacts, not source.
/dist

# This workspace ships binaries (rmaild, mail), so the lockfile is committed for
# reproducible builds. Override a global gitignore that excludes it.
!Cargo.lock

# Same reason: a `*.test` rule in the global gitignore swallows this one, and
# `scripts/docker-test.sh` — which is how the whole project runs its tests —
# is useless without it. Nothing here should depend on a developer's personal
# ignore file.
!Dockerfile.test

